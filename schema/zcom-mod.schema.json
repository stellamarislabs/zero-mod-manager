{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-mod-manager.github.io/schema/mod-manifest-v2.json",
  "title": "Zero Mod Manager Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "name", "type"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "game": {
      "type": "object",
      "required": ["appId"],
      "properties": {
        "appId": { "const": 2075800 },
        "testedBuilds": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+$" }, "uniqueItems": true },
        "strict": { "type": "boolean", "default": false }
      }
    },
    "type": { "type": "array", "items": { "enum": ["iostore", "pak", "ue4ss", "gamedir", "plugin", "config"] }, "minItems": 1, "uniqueItems": true },
    "nexus": {
      "type": "object",
      "properties": {
        "modId": { "type": "integer", "minimum": 1 },
        "fileId": { "type": "integer", "minimum": 1 }
      }
    },
    "platforms": { "type": "array", "items": { "enum": ["windows", "linux", "proton", "steam-deck"] }, "uniqueItems": true },
    "launchers": { "type": "array", "items": { "enum": ["steam", "ea", "manual"] }, "uniqueItems": true },
    "runtime": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "dependencies": { "$ref": "#/$defs/relations" },
    "incompatibilities": { "$ref": "#/$defs/relations" },
    "loadAfter": { "$ref": "#/$defs/relations" },
    "configSchema": { "type": "object" },
    "requires": { "type": "object", "properties": { "ue4ss": { "type": "boolean" } } }
  },
  "$defs": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "reason": { "type": "string" },
          "evidenceUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
