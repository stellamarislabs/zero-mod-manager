{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeromodmanager.example/schema/profile-lock-v1.json",
  "title": "Zero Mod Manager Profile Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileName", "notes", "exportedAt", "mods"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "notes": { "type": "string", "maxLength": 4000 },
    "requiredRuntime": { "type": ["string", "null"] },
    "exportedAt": { "type": "string", "format": "date-time" },
    "gameBuild": { "type": ["string", "null"] },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "modType", "enabled", "fileHashes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "bundleId": { "type": ["string", "null"], "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"] },
          "modType": { "enum": ["pak", "iostore", "ue4ss", "game-directory", "plugin", "config"] },
          "enabled": { "type": "boolean" },
          "loadPriority": { "type": ["integer", "null"] },
          "nexusModId": { "type": ["integer", "null"], "minimum": 1 },
          "nexusFileId": { "type": ["integer", "null"], "minimum": 1 },
          "fileHashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } },
          "fomodAnswers": { "type": ["string", "null"] }
        }
      }
    }
  }
}
